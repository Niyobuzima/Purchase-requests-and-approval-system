# Django
DEBUG=True
SECRET_KEY=your-secret-key-here-generate-with-django
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# For Docker, use: DB_HOST=db
# For local PostgreSQL, use: DB_HOST=localhost
DB_NAME=p2p_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Cloudinary (will add later)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OpenAI (will add later)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440

# Email Configuration (Gmail SMTP)
# To use Gmail for sending emails:
# 1. Enable 2-Factor Authentication on your Google Account
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Generate an App Password for "Mail"
# 4. Copy the 16-character password (without spaces) and paste it below
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password-here
DEFAULT_FROM_EMAIL=ProcureFlow <noreply@procureflow.com>

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:5174
